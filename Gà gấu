-- ============================================================================
local function deepAnalysis()
    for i = 1, 5 do anaTxt[i].Text = anaTitle[i] .. ": --" end
    if #history < 3 then return "Ga", 50 end
    
    local scoreGa, scoreGau = 0, 0
    local lastSide = history[#history]

    -- TẦNG 1: THUẬN THEO NHỊP CẦU NHẢY 1-1
    if #history >= 3 then
        local l1, l2, l3 = history[#history], history[#history-1], history[#history-2]
        if l1 ~= l2 and l2 ~= l3 then
            if l1 == "Ga" then
                scoreGau = scoreGau + 3.0
                anaTxt[1].Text = anaTitle[1] .. ": Khớp nhịp nhảy 1-1 -> Chọn GẤU (+3.0)"
                aiMsg.Text = "🤖 Em guộc AI: Cầu 1-1 kìa thằng lồn! Theo nhịp GẤU ngay!"
            else
                scoreGa = scoreGa + 3.0
                anaTxt[1].Text = anaTitle[1] .. ": Khớp nhịp nhảy 1-1 -> Chọn GÀ (+3.0)"
                aiMsg.Text = "🤖 Em guộc AI: Nhịp nhảy 1-1 mượt quá, lệnh này bám GÀ nhe đại ca!"
            end
        else
            anaTxt[1].Text = anaTitle[1] .. ": Nhịp cầu đang chạy tự do"
        end
    end

    -- TẦNG 2: TỶ LỆ ÉP BẺ CẦU BỆT DÀI
    local streak = 1
    for i = #history - 1, 1, -1 do
        if history[i] == lastSide then streak = streak + 1 else break end
    end

    if streak >= 3 then
        local breakMultiplier = 1.0 + (streak * 1.5)
        if lastSide == "Ga" then
            scoreGau = scoreGau + breakMultiplier
            anaTxt[2].Text = string.format("%s: GÀ bệt dài (%d cây) -> ÉP BẺ GẤU (+%.1f)", anaTitle[2], streak, breakMultiplier)
            aiMsg.Text = string.format("🤖 Em guộc AI: Gà bệt %d cây rồi, sòng chuẩn bị hồi Gấu, lực bẻ đang tăng!", streak)
        else
            scoreGa = scoreGa + breakMultiplier
            anaTxt[2].Text = string.format("%s: GẤU bệt dài (%d cây) -> ÉP BẺ GÀ (+%.1f)", anaTitle[2], streak, breakMultiplier)
            aiMsg.Text = string.format("🤖 Em guộc AI: Gấu bệt dai quá (%d cây), em tính toán lực ép bẻ Gà cực căng!", streak)
        end
    else
        anaTxt[2].Text = anaTitle[2] .. ": Độ dài chuỗi bệt bình thường"
    end

    -- TẦNG 3: MẬT ĐỘ DIỆN RỘNG (CÁI NÀO RA ÍT THÌ THEO)
    local cGa, cGau = 0, 0
    local scanRange = math.min(25, #history)
    for i = #history - scanRange + 1, #history do
        if history[i] == "Ga" then cGa = cGa + 1 else cGau = cGau + 1 end
    end
    if cGa ~= cGau then
        local densityBonus = math.abs(cGa - cGau) * 0.7
        if cGa > cGau then
            scoreGau = scoreGau + densityBonus
            anaTxt[3].Text = string.format("%s: GẤU lép vế -> Ưu tiên hồi GẤU (+%.1f)", anaTitle[3], densityBonus)
        else
            scoreGa = scoreGa + densityBonus
            anaTxt[3].Text = string.format("%s: GÀ lép vế -> Ưu tiên hồi GÀ (+%.1f)", anaTitle[3], densityBonus)
        end
    else
        anaTxt[3].Text = anaTitle[3] .. ": Sòng cân bằng tỉ lệ khuyết"
    end

    -- TẦNG 4 & 5
    if #history >= 3 then
        local m1, m2 = history[#history], history[#history-1]
        local tGa, tGau = 0, 0
        for i = 1, #history - 2 do
            if history[i] == m2 and history[i+1] == m1 then
                if history[i+2] == "Ga" then tGa = tGa + 1 else tGau = tGau + 1 end
            end
        end
        if tGa + tGau > 0 then
            if tGa > tGau then scoreGau = scoreGau + 1.2 else scoreGa = scoreGa + 1.2 end
        end
    end
    anaTxt[4].Text = anaTitle[4] .. ": Đang tính toán nhịp xung vận hành"
    anaTxt[5].Text = anaTitle[5] .. ": Lõi Matrix đồng bộ dữ liệu"

    local totalScore = scoreGa + scoreGau
    if totalScore == 0 then return (lastSide == "Ga" and "Gau" or "Ga"), 50 end
    
    local finalProbGa = (scoreGa / totalScore) * 100
    finalProbGa = math.clamp(finalProbGa, 15, 85)
    
    barGa.Size = UDim2.new(finalProbGa / 100, 0, 1, 0)
    barGau.Size = UDim2.new((100 - finalProbGa) / 100, 0, 1, 0)
    barGau.Position = UDim2.new(finalProbGa / 100, 0, 0, 0)
    barLabel.Text = string.format("🐥 GÀ %.0f%% | 🐻 GẤU %.0f%%", finalProbGa, 100 - finalProbGa)

    if scoreGa > scoreGau then
        return "Ga", 50 + math.floor((scoreGa / totalScore) * 45)
    else
        return "Gau", 50 + math.floor((scoreGau / totalScore) * 45)
    end
end

local function updateUI()
    local ga, gau, emo = 0, 0, {}
    for i = math.max(1, #history - 9), #history do
        if history[i] == "Ga" then ga = ga + 1; table.insert(emo, "🐥") else gau = gau + 1; table.insert(emo, "🐻") end
    end
    countText.Text = "🐥 Gà: " .. ga .. " | 🐻 Gấu: " .. gau
    hisText.Text = #emo > 0 and "📜 Lịch sử: " .. table.concat(emo, " ") or "📜 Lịch sử: [---]"
    local leader = player:FindFirstChild("leaderstats")
    local vnd = leader and leader:FindFirstChild("VND")
    moneyText.Text = "💰 Số Dư Tài Khoản: " .. string.format("%.0f", vnd and vnd.Value or 0) .. " VND"
    betText.Text = "💰 Cược Hiện Tại: " .. (betCur >= 1e6 and string.format("%.1fM", betCur / 1e6) or tostring(betCur))
end

-- REALTIME NETWORK SYNC
task.spawn(function()
    local remote = RS:WaitForChild("Remote", 10)
    if not remote then return end
    local upd = remote:WaitForChild("GaGauUpdate", 10)
    if not upd then return end

    upd.OnClientEvent:Connect(function(act, ...)
        local args = { ... }
        if act == "Countdown" then
            local sec = args[1]
            timeText.Text = "⏱️ XUNG NHỊP GAME: " .. sec .. "s"
            
            if sec == 25 and auto and not betPlaced and not frozen then
                local side, conf = deepAnalysis()
                if conf >= confThres then
                    lastPred = side
                    betPlaced = true
                    ketqua.Text = string.format("🔮 MEMAYBEOHUB CHỌN: %s\n📊 ĐỘ TỰ TIN: %d%%", side == "Ga" and "🐥 GÀ" or "🐻 GẤU", conf)
                    execBet(side, betCur)
                else
                    ketqua.Text = string.format("🔮 BỎ QUA PHIÊN NÀY (%d%% < %d%%)", conf, confThres)
                end
            end
        elseif act == "Result" then
            local winner = args[1]
            if not winner then return end
            local clean = (string.lower(winner) == "gau") and "Gau" or "Ga"

            if lastPred ~= "" and betPlaced then
                if lastPred == clean then
                    wins = wins + 1
                    loses = 0
                    betCur = betBase
                    frozen = false
                    aiMsg.Text = "🤖 Em guộc AI: Địt mẹ game tuổi con cặc ngon ko em."
                else
                    loses = loses + 1
                    if loses >= loseMax then
                        frozen = true
                        betCur = betBase
                        aiMsg.Text = "🤖 Em guộc AI: Cái lồn mẹ nó game như cặc!"
                    else
                        betCur = betCur * betMulti
                        aiMsg.Text = string.format("🤖 Em guộc AI: Cầu gãy rồi thằng ngu để bố tính!", betMulti)
                    end
                end
                winText.Text = string.format("🏆 Thắng: %d/%d | Thua lt: %d", wins, winTarget, loses)
            end

            table.insert(history, clean)
            if #history > 35 then table.remove(history, 1) end
            updateUI()

            lastPred = ""
            betPlaced = false
            if wins >= winTarget then
                autoBtn.Text = "🏆 ĐÃ ĐẠT CHỈ TIÊU HOÀN THÀNH!"
                autoBtn.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
                auto = false
                aiMsg.Text = "🤖 Em guộc AI: Nghỉ đi thằng lồn địt mẹ tham thì thua nếu thắng mua key tiếp nhé!"
            end
        elseif act == "SyncState" then
            local data = args[1] or {}
            if data.history then
                table.clear(history)
                for _, v in ipairs(data.history) do
                    table.insert(history, (string.lower(tostring(v)) == "gau") and "Gau" or "Ga")
                end
                while #history > 35 do table.remove(history, 1) end
                updateUI()
            end
        end
    end)
    upd:FireServer("RequestSync")
end)

