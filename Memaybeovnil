    local suKien = jobGame and jobGame:FindFirstChild("SuKien") 
    local dropLoot = suKien and suKien:FindFirstChild("DropLoot")
    if dropLoot then 
        for _, child in pairs(dropLoot:GetChildren()) do 
            if (child:IsA("Model") or child:IsA("BasePart")) and not string.find(string.lower(child.Name), "drop") then 
                return child 
            end 
        end 
    end
    return nil
end

