-- KHÓA VẬN TỐC RƠI TỰ DO BẰNG 0 LIÊN TỤC ĐỂ KHÔNG BỊ TÍNH FALL DAMAGE
RunService.Stepped:Connect(function()
    if _G.AutoLoot and player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                if part.Name == "HumanoidRootPart" then
                    part.Velocity = Vector3.new(0, 0, 0) -- Triệt tiêu gia tốc rơi
                end
            end
        end
    end
end)

-- BỘ LỌC CHỈ TÌM RƯƠNG CHÍNH CHỦ
local function findValidChestOnly()
    local jobGame = workspace:FindFirstChild("JobGame")
    local suKien = jobGame and jobGame:FindFirstChild("SuKien")
    local dropLoot = suKien and suKien:FindFirstChild("DropLoot")
    
    if dropLoot then
        for _, child in pairs(dropLoot:GetChildren()) do
            if child:IsA("Model") or child:IsA("BasePart") then
                local nameLower = string.lower(child.Name)
                if not string.find(nameLower, "drop") then
                    return child
                end
            end
        end
    end
    return nil
end

-- ENGINE BAY CHỮ L CHỐNG SÁT THƯƠNG RƠI
local function safeAntiFallFlyTo(targetPos)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("Humanoid").Health <= 0 then return end
    
    local normalSpeed = 77
    local landingSpeed = 15 -- 🛡️ Tốc độ rà phanh cực chậm khi tiếp đất để né chết oan
    local startPos = root.Position
    
    -- BƯỚC 1: BAY VỌT THẲNG ĐỨNG LÊN TRỜI (+45 BLOCK)
    local skyStartPos = Vector3.new(startPos.X, startPos.Y + 45, startPos.Z)
    currentTween = TweenService:Create(root, TweenInfo.new((root.Position - skyStartPos).Magnitude / normalSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(skyStartPos)})
    currentTween:Play()
    currentTween.Completed:Wait()
    if not _G.AutoLoot then return end

    -- BƯỚC 2: DI CHUYỂN TRÊN KHÔNG ĐẾN ĐỈNH ĐẦU RƯƠNG
    local skyTargetPos = Vector3.new(targetPos.X, skyStartPos.Y, targetPos.Z)
    currentTween = TweenService:Create(root, TweenInfo.new((root.Position - skyTargetPos).Magnitude / normalSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(skyTargetPos)})
    currentTween:Play()
    currentTween.Completed:Wait()
    if not _G.AutoLoot then return end

    -- BƯỚC 3: ĐÁP XUỐNG ĐIỂM CHỜ TRÊN CAO CÁCH RƯƠNG 8 BLOCK (VẪN CHẠY TỐC ĐỘ NHANH)
    local breakPointPos = Vector3.new(targetPos.X, targetPos.Y + 8, targetPos.Z)
    currentTween = TweenService:Create(root, TweenInfo.new((root.Position - breakPointPos).Magnitude / normalSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(breakPointPos)})
    currentTween:Play()
    currentTween.Completed:Wait()
    if not _G.AutoLoot then return end

    -- BƯỚC 4: RÀ PHANH TỪ TỪ ĐÁP XUỐNG TÂM RƯƠNG (SPEED 15) CHỐNG DIE
    currentTween = TweenService:Create(root, TweenInfo.new((root.Position - targetPos).Magnitude / landingSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos + Vector3.new(0, 1.2, 0))})
    currentTween:Play()
    currentTween.Completed:Wait()
end

-- VÒNG LẶP PHỤC KÍCH RƯƠNG THỜI GIAN THỰC
local lootTask = nil
local function startLoot()
    if lootTask then task.cancel(lootTask) end
    
    lootTask = task.spawn(function()
        while _G.AutoLoot do
            pcall(function()
                -- Kiểm tra trạng thái nếu nhân vật lỡ bị bất tỉnh trước đó thì không chạy
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then 
                    statusText.Text = "❌ Bạn đã chết/bất tỉnh! Chờ hồi sinh..."
                    statusText.TextColor3 = Color3.fromRGB(255, 50, 50)
                    task.wait(1) 
                    return 
                end

                local chestObject = findValidChestOnly()
                if chestObject then
                    local targetPos = chestObject:GetPivot().Position
                    local prompt = chestObject:FindFirstChildWhichIsA("ProximityPrompt", true)
                    
                    statusText.Text = "⚡ ANTI-FALL: Đang đáp chữ L xuống " .. chestObject.Name
                    statusText.TextColor3 = Color3.fromRGB(255, 200, 50)
                    
                    safeAntiFallFlyTo(targetPos)
                    task.wait(0.05)
                    
                    -- Gom quà an toàn
                    if prompt then
                        fireproximityprompt(prompt)
                        task.wait(0.15)
                        fireproximityprompt(prompt)
                    else
                        local backupOpen = chestObject:FindFirstChild("Open") and chestObject.Open:FindFirstChildWhichIsA("ProximityPrompt")
                        if backupOpen then fireproximityprompt(backupOpen) end
                    end
                    task.wait(0.4)
                else
                    statusText.Text = "⏳ Đang phục kích... Đã bật rà phanh tiếp đất an toàn!"
                    statusText.TextColor3 = Color3.fromRGB(0, 255, 255)
                end
            end)
            task.wait(0.05)
        end
    end)
end

