-- THUẬT TOÁN ĐA TẦNG ĐẢO CHIỀU ĐỘNG (NÂNG CẤP CHỐNG SAI SỐ)
-- ============================================================================
local function matchPattern(seq)
    if #seq < 2 then return nil, 0 end
    local total, ga, gau = 0, 0, 0
    for i = 1, #db.all - #seq do
        local match = true
        for j = 1, #seq do if db.all[i+j-1] ~= seq[j] then match = false break end end
        if match then
            total = total + 1
            local n = db.all[i + #seq]
            if n == "Ga" then ga = ga + 1 elseif n == "Gau" then gau = gau + 1 end
        end
    end
    if total >= 3 then
        if ga > gau then return "Ga", math.floor(ga/total*100) else return "Gau", math.floor(gau/total*100) end
    end
    return nil, 0
end

-- MẠNG NƠ RON BỔ TÚC
local wIH, wHO = {}, {}
for i = 1, 5 do wIH[i] = {} for j = 1, 8 do wIH[i][j] = (math.random()-0.5)*2 end end
for i = 1, 8 do wHO[i] = {} for j = 1, 2 do wHO[i][j] = (math.random()-0.5)*2 end end
local function sig(x) return 1/(1+math.exp(-x)) end
local function neuralPredict(inp)
    local h = {}
    for j = 1, 8 do
        local s = 0 for i = 1, 5 do s = s + inp[i] * wIH[i][j] end
        h[j] = sig(s)
    end
    local o = {0, 0}
    for j = 1, 2 do
        local s = 0 for i = 1, 8 do s = s + h[i] * wHO[i][j] end
        o[j] = sig(s)
    end
    return o
end

local function deepAnalysis()
    for i = 1, 5 do anaTxt[i].Text = anaTitle[i] .. ": --" end
    if #history < 2 then return "Ga", 50 end
    local sGa, sGau = 0, 0

    -- Tầng 1: Phân tích Chuỗi Biến thể nâng cao
    if #history >= 4 then
        local l1, l2, l3, l4 = history[#history], history[#history-1], history[#history-2], history[#history-3]
        if l1 == l2 and l3 == l4 then
            if l1 == "Ga" then sGau = sGau + 2.2 else sGa = sGa + 2.2 end
            anaTxt[1].Text = anaTitle[1] .. ": Nhận diện cầu 2-2"
        elseif l1 ~= l2 and l2 == l3 and l3 ~= l4 then
            if l1 == "Ga" then sGau = sGau + 2.0 else sGa = sGa + 2.0 end
            anaTxt[1].Text = anaTitle[1] .. ": Nhận diện cầu nhảy 1-2-1"
        else
            anaTxt[1].Text = anaTitle[1] .. ": Đang đi sóng tự do"
        end
    end

    -- Tầng 2: Markov Chain xác suất chuyển đổi dịch vị
    local lastState = history[#history]
    local tGa, tGau = 0, 0
    for i = 1, #history - 1 do
        if history[i] == lastState then
            if history[i+1] == "Ga" then tGa = tGa + 1 else tGau = tGau + 1 end
        end
    end
    if tGa + tGau > 0 then
        local rate = tGa / (tGa + tGau)
        if rate > 0.54 then sGa = sGa + 1.8; anaTxt[2].Text = anaTitle[2] .. ": Thiên hướng GÀ"
        elseif rate < 0.46 then sGau = sGau + 1.8; anaTxt[2].Text = anaTitle[2] .. ": Thiên hướng GẤU"
        else anaTxt[2].Text = anaTitle[2] .. ": Tỷ lệ 50/50" end
    end

    -- Tầng 3: Kháng Bão (Bẻ chuỗi dồn nâng cao)
    local streak, cur = 1, history[#history]
    for i = #history - 1, 1, -1 do if history[i] == cur then streak = streak + 1 else break end end
    if streak >= 3 then
        local weight = 1.5 + (streak * 0.5)
        if cur == "Ga" then sGau = sGau + weight else sGa = sGa + weight end
        anaTxt[3].Text = anaTitle[3] .. ": Ép bẻ bão chuỗi " .. streak
    else
        anaTxt[3].Text = anaTitle[3] .. ": Nhịp bão an toàn"
    end

    -- Tầng 4: AI Mạng Nơ-ron phi tuyến 5 phiên
    if #history >= 5 then
        local inp = {}
        for i = #history - 4, #history do table.insert(inp, (history[i] == "Ga") and 1 or 0) end
        local out = neuralPredict(inp)
        if out[1] > out[2] + 0.1 then sGa = sGa + 2.5; anaTxt[4].Text = anaTitle[4] .. ": Định vị GÀ"
        elseif out[2] > out[1] + 0.1 then sGau = sGau + 2.5; anaTxt[4].Text = anaTitle[4] .. ": Định vị GẤU"
        else anaTxt[4].Text = anaTitle[4] .. ": AI nhiễu tín hiệu" end
    end

    -- Tầng 5: Quét Database khớp mẫu lịch sử sâu
    if #history >= 3 then
        local sample = {}
        for i = math.max(1, #history - 3), #history do table.insert(sample, history[i]) end
        local side, matchConf = matchPattern(sample)
        if side then
            local dbW = 3.0 * (matchConf / 100)
            if side == "Ga" then sGa = sGa + dbW else sGau = sGau + dbW end
            anaTxt[5].Text = string.format("%s: Khớp %s (%d%%)", anaTitle[5], (side == "Ga" and "GÀ" or "GẤU"), matchConf)
        else
            anaTxt[5].Text = anaTitle[5] .. ": Mẫu chuỗi mới"
        end
    end

    -- 🔴 CƠ CHẾ ĐẢO CHIỀU KHÁNG SAI: Nếu đang trong chuỗi thua, tự động đảo ngược phân tích
    if loses >= 1 then
        local temp = sGa
        sGa = sGau
        sGau = temp
        addLog("[AI ENGINE] Phát hiện gãy nhịp game, kích hoạt đảo chiều thuật toán!", Color3.fromRGB(251, 146, 60))
    end

    local total = sGa + sGau
    if total == 0 then return "Ga", 50 end
    local pGa = (sGa / total) * 100
    barGa.Size = UDim2.new(pGa / 100, 0, 1, 0)
    barGau.Size = UDim2.new((100 - pGa) / 100, 0, 1, 0)
    barGau.Position = UDim2.new(pGa / 100, 0, 0, 0)
    barLabel.Text = string.format("🐥 GÀ %.0f%% | 🐻 GẤU %.0f%%", pGa, 100 - pGa)

    if sGa > sGau then return "Ga", 50 + math.floor((sGa / total) * 45)
    else return "Gau", 50 + math.floor((sGau / total) * 45) end
end

local function updateUI()
    local ga, gau, emo = 0, 0, {}
    for i = math.max(1, #history - 9), #history do
        if history[i] == "Ga" then ga = ga + 1; table.insert(emo, "🐥") else gau = gau + 1; table.insert(emo, "🐻") end
    end
    countText.Text = "🐥 Gà: " .. ga .. " | 🐻 Gấu: " .. gau
    hisText.Text = #emo > 0 and "📜 Lịch sử: " .. table.concat(emo, " ") or "📜 Lịch sử: [---]"
    local leader = player:FindFirstChild("leaderstats")
    local vnd = leader and leader:FindFirstChild("VND")
    moneyText.Text = "💰 Số Dư Tài Khoản: " .. string.format("%.0f", vnd and vnd.Value or 0) .. " VND"
end

