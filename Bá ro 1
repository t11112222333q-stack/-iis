-- DỊCH CHUYỂN CỔNG T1
local function EnterBossZone()
    local t1 = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Teleport") and workspace.Map.Teleport:FindFirstChild("T1")
    if t1 then
        local prompt = t1:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
            rootPart.CFrame = t1.CFrame * CFrame.new(0, 1, 0)
            task.wait(0.2)
            prompt.HoldDuration = 0
            prompt.RequiresLineOfSight = false
            prompt:InputHoldBegin()
            prompt:Trigger()
            prompt:InputHoldEnd()
            task.wait(0.1)
            prompt:InputHoldBegin()
            prompt:Trigger()
            prompt:InputHoldEnd()
            return true
        end
    end
    return false
end
btnEnter.MouseButton1Click:Connect(EnterBossZone)

-- SERVER HOP
local function HopToLowestServer()
    txtStatus.Text = "Đang tìm server vắng để lẩn trốn..."
    txtStatus.TextColor3 = Color3.fromRGB(245, 158, 11)
    btnServerHop.Text = "ĐANG TRUY CẬP API ROBLOX..."
    task.spawn(function()
        local success, servers = pcall(function() return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")) end)
        if success and servers and servers.data then
            local bestServer = nil
            local minPlayers = math.huge
            for _, server in pairs(servers.data) do
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    if server.playing < minPlayers then minPlayers = server.playing; bestServer = server.id end
                end
            end
            if bestServer then TeleportService:TeleportToPlaceInstance(game.PlaceId, bestServer, player) else txtStatus.Text = "Không tìm thấy server trống tốt hơn." btnServerHop.Text = "⚡ ĐỔI SANG SERVER ÍT NGƯỜI NHẤT" end
        else txtStatus.Text = "Lỗi API. Thử lại sau." btnServerHop.Text = "⚡ ĐỔI SANG SERVER ÍT NGƯỜI NHẤT" end
    end)
end
btnServerHop.MouseButton1Click:Connect(HopToLowestServer)

-- RADAR
local function ScanForPlayers()
    if not rootPart then return false end
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (rootPart.Position - otherPlayer.Character.HumanoidRootPart.Position).Magnitude
            if distance < BAN_KINH_SCAN_NGUOI then return true, otherPlayer.Name end
        end
    end
    return false, nil
end

-- TÌM BOSS VÀ KIỂM TRA ĐIỀU KIỆN SỐNG (FIX LỖI BOSS CHẾT VẪN BAY)
local function FindNearestBoss()
    if not rootPart then return nil end
    local bossZone = workspace:FindFirstChild("Boss Zone")
    local bossModel = bossZone and bossZone:FindFirstChild("Boss")
    
    if bossModel then
        -- Kiểm tra máu của Boss (Nếu có Humanoid)
        local bHumanoid = bossModel:FindFirstChildOfClass("Humanoid")
        if bHumanoid and bHumanoid.Health <= 0 then
            return nil -- Boss chết rồi thì coi như không tìm thấy mục tiêu
        end
        
        local targetPart = bossModel:FindFirstChild("Hitbox") or bossModel:FindFirstChild("HumanoidRootPart")
        if targetPart and targetPart:IsA("BasePart") then
            return targetPart
        end
    end
    return nil
end

-- LUỒNG CLICK TỰ ĐỘNG
local function StartClickThread()
    if clickThread then task.cancel(clickThread) end
    clickThread = task.spawn(function()
        while isAutoFarmEnabled do
            task.wait(TOC_DO_CLICK)
            -- Chỉ bấm click khi có mục tiêu Boss sống để tránh bug vũ khí
            if FindNearestBoss() and character:FindFirstChildOfClass("Tool") then
                character:FindFirstChildOfClass("Tool"):Activate()
            end
        end
    end)
end

