local function GetPlayerGuiNameLabel()
    local success, result = pcall(function() return player.PlayerGui.PlayerGui.NameLabel end)
    return success and result or nil
end

local function UpdateAllNames(targetName)
    local guiLabel = GetPlayerGuiNameLabel()
    if guiLabel then guiLabel.Text = targetName end
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then hum.DisplayName = targetName end
    for _, desc in pairs(char:GetDescendants()) do
        if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            for _, child in pairs(desc:GetDescendants()) do
                if child:IsA("TextLabel") then
                    if targetName == "" then desc.Enabled = false; child.Text = "" else desc.Enabled = true; child.Text = targetName end
                end
            end
        end
    end
end

player.CharacterAdded:Connect(function(newChar)
