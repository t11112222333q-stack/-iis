-- CHỨC NĂNG VÀO CỔNG T1
local function EnterBossZone()
    local t1 = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Teleport") and workspace.Map.Teleport:FindFirstChild("T1")
    if t1 then
        local prompt = t1:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
            rootPart.CFrame = t1.CFrame * CFrame.new(0, 1, 0)
            task.wait(0.2)
            prompt.HoldDuration = 0
            prompt.RequiresLineOfSight = false
            prompt:InputHoldBegin()
            prompt:Trigger()
            prompt:InputHoldEnd()
            task.wait(0.1)
            prompt:InputHoldBegin()
            prompt:Trigger()
            prompt:InputHoldEnd()
            return true
        end
    end
    return false
end
