-- VÒNG LẶP ENGINE FARM CHÍNH
local function StartMainFarmLoop()
    if farmConnection then farmConnection:Disconnect() end
    StartClickThread()
    
    farmConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not isAutoFarmEnabled or not rootPart or not humanoid then return end
        
        -- 1. KIỂM TRA RADAR NGƯỜI CHƠI LẠ
        local playerDetected, detectorName = ScanForPlayers()
        if playerDetected then
            isAutoFarmEnabled = false
            txtRadar.Text = "⚠️ PHÁT HIỆN: [".. detectorName .."]! ĐANG CHẠY TRỐN..."
            txtRadar.TextColor3 = Color3.fromRGB(239, 68, 68)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38); toggleBtn.Text = "BẬT ULTIMATE EVASION FARM"
            if farmConnection then farmConnection:Disconnect() end
            if clickThread then task.cancel(clickThread) end
            if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
            HopToLowestServer()
            return
        else
            txtRadar.Text = "🟢 Radar an toàn (Không có người chơi khác lại gần)"
            txtRadar.TextColor3 = Color3.fromRGB(34, 197, 94)
        end
        
        -- 2. ENGINE PHÂN TÍCH DI CHUYỂN CỦA BOSS TRÁNH KẸT
        local bossModel = GetValidBossModel()
        if bossModel then
            local bossTargetPart = bossModel:FindFirstChild("Hitbox") or bossModel:FindFirstChild("HumanoidRootPart") or bossModel.PrimaryPart
            
            if bossTargetPart then
                -- Thuật toán check xem boss đứng yên hay di chuyển
                if lastBossPosition then
                    local moveDistance = (bossTargetPart.Position - lastBossPosition).Magnitude
                    if moveDistance < 0.2 then -- Boss di chuyển cực ít hoặc đứng yên
                        bossStuckTime = bossStuckTime + deltaTime
                        if bossStuckTime >= 3.0 then -- Đứng yên quá 3 giây coi như bị kẹt
                            IS_BOSS_STUCK = true
                        end
                    else
                        bossStuckTime = 0
                        IS_BOSS_STUCK = false
                    end
                end
                lastBossPosition = bossTargetPart.Position
                
                --------------------------------------------------------
                -- XỬ LÝ DI CHUYỂN DỰA TRÊN TRẠNG THÁI CỦA BOSS
                if IS_BOSS_STUCK then
                    -- NẾU BOSS BỊ KẸT: Né về vị trí đã lưu để đợi
                    txtStatus.Text = "⚠️ BOSS ĐANG ĐỨNG YÊN / KẸT! NÉ VỀ VỊ TRÍ CHỜ..."
                    txtStatus.TextColor3 = Color3.fromRGB(251, 191, 36)
                    
                    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                    
                    if savedCFrame then
                        -- Bay về điểm bạn đã tự tay bấm lưu lúc nãy
                        rootPart.CFrame = CFrame.lookAt(savedCFrame.Position, bossTargetPart.Position)
                    else
                        -- Dự phòng nếu quên chưa lưu vị trí: Treo tạm trên cao tâm Boss Zone
                        local bossZone = workspace:FindFirstChild("Boss Zone")
                        if bossZone then
                            rootPart.CFrame = CFrame.lookAt(bossZone.Position + Vector3.new(0, 18, 0), bossTargetPart.Position)
                        end
                    end
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                else
                    -- NẾU BOSS DI CHUYỂN BÌNH THƯỜNG: Tiếp tục bay vòng tròn và hướng mặt vào boss
                    local banKinhHitbox = math.max(bossTargetPart.Size.X, bossTargetPart.Size.Z) / 2
                    local banKinhBayThucTe = banKinhHitbox + MIN_KHOANG_CACH_AN_TOAN
                    
                    txtStatus.Text = "🎯 ORBITING BOSS: " .. bossModel.Name
                    txtStatus.TextColor3 = Color3.fromRGB(168, 85, 247)
                    
                    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                    
                    gocQuay = gocQuay + (deltaTime * TOC_DO_BAY)
                    local targetPos = bossTargetPart.Position + Vector3.new(math.cos(gocQuay) * banKinhBayThucTe, DO_CAO_BAY, math.sin(gocQuay) * banKinhBayThucTe)
                    
                    rootPart.CFrame = CFrame.lookAt(targetPos, bossTargetPart.Position)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
                --------------------------------------------------------
            end
        else
            -- KHI BOSS CHẾT HOẶC CHỜ HỒI SINH
            CleanupObstacles()
            lastBossPosition = nil
            bossStuckTime = 0
            IS_BOSS_STUCK = false
            
            txtStatus.Text = "⏳ Đợi Boss xuất hiện / hồi sinh..."
            txtStatus.TextColor3 = Color3.fromRGB(245, 158, 11)
            
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            
            -- Đứng chờ tại vị trí đã lưu nếu có, không thì đứng ở tâm map trên cao
            if savedCFrame then
                rootPart.CFrame = savedCFrame
            else
                local bossZone = workspace:FindFirstChild("Boss Zone")
                if bossZone then
                    rootPart.CFrame = CFrame.new(bossZone.Position + Vector3.new(0, 16, 0))
                else
                    EnterBossZone()
                    task.wait(1.0)
                end
            end
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

-- HÀM XỬ LÝ BẬT/TẮT VÀ TỰ ĐỘNG REBOOT KHI QUA CỔNG
local function ExecuteToggle(forceState)
    if forceState ~= nil then isAutoFarmEnabled = forceState else isAutoFarmEnabled = not isAutoFarmEnabled end
    
    if isAutoFarmEnabled then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(22, 163, 74); toggleBtn.Text = "TẮT HỆ THỐNG FARM"
        txtStatus.Text = "Trạng thái: Đang kết nối mục tiêu..."; txtStatus.TextColor3 = Color3.fromRGB(34, 197, 94)
        
        local hasZone = workspace:FindFirstChild("Boss Zone")
        if not hasZone then
            EnterBossZone()
            task.spawn(function()
                txtStatus.Text = "🔄 Đang tự động kích hoạt lại hệ thống..."; txtStatus.TextColor3 = Color3.fromRGB(251, 191, 36)
                task.wait(0.8) 
                if isAutoFarmEnabled then
                    ExecuteToggle(false)
                    task.wait(0.1)
                    ExecuteToggle(true)
                end
            end)
            return 
        end
        StartMainFarmLoop()
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38); toggleBtn.Text = "BẬT ULTIMATE EVASION FARM"
        txtStatus.Text = "Trạng thái: Đang tắt..."; txtStatus.TextColor3 = Color3.fromRGB(150, 150, 150)
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        if farmConnection then farmConnection:Disconnect() farmConnection = nil end
        if clickThread then task.cancel(clickThread) clickThread = nil end
    end
end

toggleBtn.MouseButton1Click:Connect(function() ExecuteToggle(nil) end)
player.CharacterAdded:Connect(function(char) character = char; rootPart = char:WaitForChild("HumanoidRootPart"); humanoid = char:WaitForChild("Humanoid") end)

