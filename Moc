-- HÀM KHỞI TẠO NÚT BẤM PREMIUM TWEEN
local function createButton(text, pos, baseColor)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, -30, 0, 38)
    btn.Position = UDim2.new(0, 15, 0, pos)
    btn.BackgroundColor3 = baseColor
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(255, 255, 255)
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.9

    btn.MouseEnter:Connect(function()
        Tweens:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.15}):Play()
        Tweens:Create(btnStroke, TweenInfo.new(0.2), {Transparency = 0.6}):Play()
    end)
    btn.MouseLeave:Connect(function()
        Tweens:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
        Tweens:Create(btnStroke, TweenInfo.new(0.2), {Transparency = 0.9}):Play()
    end)
    
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Tweens:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, -34, 0, 36), Position = UDim2.new(0, 17, 0, pos + 1)}):Play()
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Tweens:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, -30, 0, 38), Position = UDim2.new(0, 15, 0, pos)}):Play()
        end
    end)

    return btn
end

