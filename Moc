-- RADAR & AUTO FARM
local function ScanForPlayers()
    if not rootPart then return false, nil end
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (rootPart.Position - otherPlayer.Character.HumanoidRootPart.Position).Magnitude
            if distance < BAN_KINH_SCAN_NGUOI then return true, otherPlayer.Name end
        end
    end
    return false, nil
end

local function HopToLowestServer()
    txtStatus.Text = "Trạng thái: Đang đổi Server..."
    pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?limit=100")).data
        for _, s in pairs(servers) do 
            if s.playing < s.maxPlayers and s.id ~= game.JobId then 
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player) 
                break 
            end 
        end
    end)
end

local function CleanupObstacles()
    pcall(function()
        local bossZone = workspace:FindFirstChild("Boss Zone")
        if bossZone and bossZone:FindFirstChild("BOSSZONE") then
            local folder = bossZone.BOSSZONE
            local nui = folder:FindFirstChild("Núi") or folder:FindFirstChild("N\195\186i")
            if nui then nui:Destroy() end
            if folder:FindFirstChild("HieuUng") then folder.HieuUng:Destroy() end
        end
        if bossZone then
            for _, d in pairs(bossZone:GetDescendants()) do if d:IsA("BasePart") and d.Name == "PartTangHinh" then d:Destroy() end end
        end
    end)
end

btnCleanup.MouseButton1Click:Connect(function()
    CleanupObstacles()
    txtStatus.Text = "Trạng thái: Đã dọn dẹp vật cản! ✨"
    task.wait(1)
    txtStatus.Text = "Trạng thái: Sẵn sàng hành động"
end)

local function GetBoss()
    local b = workspace:FindFirstChild("Boss Zone") and workspace["Boss Zone"]:FindFirstChild("Boss")
    return (b and b:FindFirstChild("Hitbox") and b:FindFirstChildOfClass("Humanoid").Health > 0) and b or nil
end

toggleBtn.MouseButton1Click:Connect(function()
    isAutoFarmEnabled = not isAutoFarmEnabled
    if isAutoFarmEnabled then
        toggleBtn.Text = "🔴 TẮT AUTO FARM"
        Tweens:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(22, 163, 74)}):Play()
        
        farmConnection = RunService.Heartbeat:Connect(function(dt)
            local playerDetected, detectorName = ScanForPlayers()
            if playerDetected then
                isAutoFarmEnabled = false
                if farmConnection then farmConnection:Disconnect() end
                HopToLowestServer()
                return
            end

            local boss = GetBoss()
            if boss and savedCFrame then
                tickXoay = tickXoay + dt
                local pos = boss.Hitbox.Position + Vector3.new(math.cos(tickXoay*3)*KHOANG_CACH_TIEP_CAN, 5, math.sin(tickXoay*3)*KHOANG_CACH_TIEP_CAN)
                rootPart.CFrame = CFrame.new(rootPart.Position:Lerp(pos, 0.2), boss.Hitbox.Position)
                if character:FindFirstChildOfClass("Tool") then character:FindFirstChildOfClass("Tool"):Activate() end
            else
                if savedCFrame then rootPart.CFrame = savedCFrame end
            end
        end)
    else
        toggleBtn.Text = "🟢 BẬT AUTO FARM"
        Tweens:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(220, 38, 38)}):Play()
        if farmConnection then farmConnection:Disconnect() end
    end
end)

btnSave.MouseButton1Click:Connect(function() savedCFrame = rootPart.CFrame end)
btnClear.MouseButton1Click:Connect(function() savedCFrame = nil end)
btnHop.MouseButton1Click:Connect(function() HopToLowestServer() end)
