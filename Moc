-- HÀM DỌN DẸP VẬT CẢN: XÓA SẠCH "PartTangHinh" VÀ FOLDER "Núi"
local function CleanupObstacles()
    local bossZone = workspace:FindFirstChild("Boss Zone")
    if bossZone then
        local bossZoneFolder = bossZone:FindFirstChild("BOSSZONE")
        if bossZoneFolder then
            local nuiFolder = bossZoneFolder:FindFirstChild("Núi") or bossZoneFolder:FindFirstChild("N\195\186i")
            if nuiFolder then nuiFolder:Destroy() end
        end
    end

    if bossZone then
        for _, descendant in pairs(bossZone:GetDescendants()) do
            if descendant:IsA("BasePart") and descendant.Name == "PartTangHinh" then
                descendant:Destroy()
            end
        end
    end

    local mapFolder = workspace:FindFirstChild("Map")
    if mapFolder then
        for _, descendant in pairs(mapFolder:GetDescendants()) do
            if descendant:IsA("BasePart") and descendant.Name == "PartTangHinh" then
                descendant:Destroy()
            end
        end
    end
end

CleanupObstacles()

