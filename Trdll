    local emojiHistory = {}
    local startIdx = math.max(1, #historyMemory - 9)
    for i = startIdx, #historyMemory do
        if historyMemory[i] == "Ga" then ga = ga + 1; table.insert(emojiHistory, "🐥")
        else gau = gau + 1; table.insert(emojiHistory, "🐻") end
    end
    countText.Text = string.format("🐥 Gà: %d  |  🐻 Gấu: %d", ga, gau)
    lichsu.Text = #emojiHistory > 0 and "📜 Lịch sử: " .. table.concat(emojiHistory, " ") or "📜 Lịch sử: [---]"
end

local function executeDeepAnalysis()
    local size = #historyMemory
    for i = 1, 6 do anaTexts[i].Text = anaTitles[i] .. ": --" end
    if size < 2 then return "Ga", 50 end
    
    local scoreGa, scoreGau = 0, 0
    
    -- H1: Trend Bias
    local cGa, cGau = 0, 0
    for i = math.max(1, size - 13), size do
        if historyMemory[i] == "Ga" then cGa = cGa + 1 else cGau = cGau + 1 end
    end
    if cGa > cGau then scoreGa = scoreGa + 1.5; anaTexts[1].Text = anaTitles[1] .. ": GÀ (" .. cGa .. "/" .. (cGa+cGau) .. ")"
    elseif cGau > cGa then scoreGau = scoreGau + 1.5; anaTexts[1].Text = anaTitles[1] .. ": GẤU (" .. cGau .. "/" .. (cGa+cGau) .. ")"
    else anaTexts[1].Text = anaTitles[1] .. ": Cân bằng" end
    
    -- H2: Dòng vốn
    if tongTienGa > 0 and tongTienGau > 0 then
        local total = tongTienGa + tongTienGau
        local pGa = (tongTienGa / total) * 100
        local pGau = (tongTienGau / total) * 100
        anaTexts[2].Text = string.format(anaTitles[2] .. ": Gà %.0f%% | Gấu %.0f%%", pGa, pGau)
        if pGa >= 68 then scoreGa = scoreGa + 2.0
        elseif pGau >= 68 then scoreGau = scoreGau + 2.0 end
    end
    
    -- H3: Pattern
    if size >= 4 then
        local l1,l2,l3,l4 = historyMemory[size], historyMemory[size-1], historyMemory[size-2], historyMemory[size-3]
        if l1 == l3 and l2 == l4 and l1 ~= l2 then
            if l1 == "Ga" then scoreGau = scoreGau + 1.8 else scoreGa = scoreGa + 1.8 end
            anaTexts[3].Text = anaTitles[3] .. ": Đối xứng 1-1"
        else anaTexts[3].Text = anaTitles[3] .. ": Chuỗi tự do" end
    end
    
    -- H4: Chống bão
    local streak = 1
    local current = historyMemory[size]
    for i = size-1, 1, -1 do
        if historyMemory[i] == current then streak = streak + 1 else break end
    end
    if streak >= 4 then
        if current == "Ga" then scoreGau = scoreGau + 2.5 else scoreGa = scoreGa + 2.5 end
        anaTexts[4].Text = string.format(anaTitles[4] .. ": Bẻ bão %s (dài %d)", current == "Ga" and "GÀ" or "GẤU", streak)
    else anaTexts[4].Text = anaTitles[4] .. ": An toàn" end
    
    -- H5: Neural Net
    if #historyMemory >= 5 then
        local inputs = {}
        for i = size-4, size do inputs[#inputs+1] = (historyMemory[i] == "Ga") and 1 or 0 end
        local outputs = neuralPredict(inputs)
        if outputs[1] > outputs[2] + 0.15 then
            scoreGa = scoreGa + 2.2
            anaTexts[5].Text = string.format(anaTitles[5] .. ": GÀ (%.0f%%)", outputs[1]*100)
        elseif outputs[2] > outputs[1] + 0.15 then
            scoreGau = scoreGau + 2.2
            anaTexts[5].Text = string.format(anaTitles[5] .. ": GẤU (%.0f%%)", outputs[2]*100)
        else anaTexts[5].Text = anaTitles[5] .. ": Chờ thêm" end
    end
    
    -- H6: Global DB
    if #historyMemory >= 3 then
        local lastFew = {}
        for i = math.max(1, size-3), size do lastFew[#lastFew+1] = historyMemory[i] end
        local matched, conf = findBestMatchByPattern(lastFew)
        if matched then
            if matched == "Ga" then scoreGa = scoreGa + 2.8 * (conf/100); anaTexts[6].Text = string.format(anaTitles[6] .. ": GÀ (%.0f%%)", conf)
            else scoreGau = scoreGau + 2.8 * (conf/100); anaTexts[6].Text = string.format(anaTitles[6] .. ": GẤU (%.0f%%)", conf) end
        else anaTexts[6].Text = anaTitles[6] .. ": Đủ 3 lần" end
    end
    
    local totalScore = scoreGa + scoreGau
    if totalScore == 0 then return "Ga", 50 end
    local probGa = (scoreGa / totalScore) * 100
    local probGau = (scoreGau / totalScore) * 100
    barGa.Size = UDim2.new(probGa/100, 0, 1, 0)
    barGau.Size = UDim2.new(probGau/100, 0, 1, 0)
    barGau.Position = UDim2.new(probGa/100, 0, 0, 0)
    barLabel.Text = string.format("🐥 GÀ %.0f%%  |  🐻 GẤU %.0f%%", probGa, probGau)
    
    if scoreGa > scoreGau then return "Ga", 50 + math.floor((scoreGa/totalScore)*45)
    else return "Gau", 50 + math.floor((scoreGau/totalScore)*45) end
end

