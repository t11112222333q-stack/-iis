-- GLOBAL DATABASE
-- ============================================================================
local GlobalDatabase = {allResults = {}, patterns = {}}
local DATA_FOLDER = "DeepMatrix_History/"
local MASTER_FILE = DATA_FOLDER .. "all_results.json"

local function addResultToDatabase(newResult)
    if not newResult then return end
    table.insert(GlobalDatabase.allResults, newResult)
    if #GlobalDatabase.allResults > 2000 then table.remove(GlobalDatabase.allResults, 1) end
    local len = #GlobalDatabase.allResults
    if len >= 3 then
        local pattern = GlobalDatabase.allResults[len-2] .. "_" .. GlobalDatabase.allResults[len-1] .. "_" .. GlobalDatabase.allResults[len]
        GlobalDatabase.patterns[pattern] = (GlobalDatabase.patterns[pattern] or 0) + 1
    end
    if hasFileSupport then
        pcall(function() WriteFile(MASTER_FILE, HttpService:JSONEncode(GlobalDatabase)) end)
    end
end

local function findBestMatchByPattern(inputSequence)
    if #inputSequence < 2 then return nil, 0 end
    local totalOcc, gaAfter, gauAfter = 0, 0, 0
    for i = 1, #GlobalDatabase.allResults - #inputSequence do
        local match = true
        for j = 1, #inputSequence do
            if GlobalDatabase.allResults[i + j - 1] ~= inputSequence[j] then match = false; break end
        end
        if match then
            totalOcc = totalOcc + 1
            local nextResult = GlobalDatabase.allResults[i + #inputSequence]
            if nextResult == "Ga" then gaAfter = gaAfter + 1 elseif nextResult == "Gau" then gauAfter = gauAfter + 1 end
        end
    end
    if totalOcc >= 3 then
        if gaAfter > gauAfter then return "Ga", math.floor((gaAfter / totalOcc) * 100)
        else return "Gau", math.floor((gauAfter / totalOcc) * 100) end
    end
    return nil, 0
end
-- ============================================================================
-- MẠNG NƠ RON 5-8-2
-- ============================================================================
local weightsIH, weightsHO = {}, {}
local function sigmoid(x) return 1 / (1 + math.exp(-x)) end

local function neuralPredict(inputs)
    local hidden = {}
    for j = 1, 8 do
        local sum = 0 for i = 1, 5 do sum = sum + inputs[i] * (weightsIH[i] and weightsIH[i][j] or 0) end
        hidden[j] = sigmoid(sum)
    end
    local outputs = {0, 0}
    for j = 1, 2 do
        local sum = 0 for i = 1, 8 do sum = sum + hidden[i] * (weightsHO[i] and weightsHO[i][j] or 0) end
        outputs[j] = sigmoid(sum)
    end
    return outputs
end

local function initNeuralNet()
    for i = 1, 5 do weightsIH[i] = {} for j = 1, 8 do weightsIH[i][j] = (math.random() - 0.5) * 2 end end
    for i = 1, 8 do weightsHO[i] = {} for j = 1, 2 do weightsHO[i][j] = (math.random() - 0.5) * 2 end end
end
initNeuralNet()
