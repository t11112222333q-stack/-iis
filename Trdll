runBacktestBtn.MouseButton1Click:Connect(function()
    local hist = GlobalDatabase.allResults
    if #hist < 20 then
        backtestResult.Text = "📈 BACKTEST\nKhông đủ dữ liệu! Cần ít nhất 20 kết quả.\nHiện có: " .. #hist .. " kết quả."
        return
    end
    local correct = 0
    local total = math.min(100, #hist - 5)
    for i = 5, total do
        local testSeq = {}
        for j = i-4, i-1 do
            table.insert(testSeq, hist[j])
        end
        local gaCount, gauCount = 0, 0
        for k = 1, #hist - #testSeq - 1 do
            local match = true
            for m = 1, #testSeq do
                if hist[k+m-1] ~= testSeq[m] then
                    match = false
                    break
                end
            end
            if match then
                local nextRes = hist[k + #testSeq]
                if nextRes == "Ga" then gaCount = gaCount + 1
                elseif nextRes == "Gau" then gauCount = gauCount + 1
                end
            end
        end
        if gaCount + gauCount >= 3 then
            local predicted = (gaCount > gauCount) and "Ga" or "Gau"
            if predicted == hist[i] then correct = correct + 1 end
        end
    end
    local accuracy = (correct / total) * 100
    backtestResult.Text = string.format("📈 KẾT QUẢ BACKTEST\n━━━━━━━━━━━━━━━━━━━━\n✅ Số phiên kiểm tra: %d\n✅ Dự đoán đúng: %d\n📊 Tỷ lệ chính xác: %.1f%%\n━━━━━━━━━━━━━━━━━━━━\nNgưỡng pattern tối thiểu: %d lần", total, correct, accuracy, CONFIG.BACKTEST_PATTERN_MIN)
