-- KẾT NỐI REMOTE (NẾU CÓ)
task.spawn(function()
    local remote = RS:FindFirstChild("Remote")
    if not remote then
        addLog("[INFO] Không tìm thấy Remote, vẫn có thể đặt cược thủ công", Color3.fromRGB(255, 200, 0))
        return
    end
    local upd = remote:FindFirstChild("GaGauUpdate")
    if not upd then
        addLog("[INFO] Không tìm thấy GaGauUpdate", Color3.fromRGB(255, 200, 0))
        return
    end

    upd.OnClientEvent:Connect(function(act, ...)
        local args = { ... }
        if act == "UpdateTotals" then
            tGa = args[1] or 0
            tGau = args[2] or 0
        elseif act == "Countdown" then
            local sec = args[1]
            timeText.Text = "⏱️ XUNG NHỊP: " .. sec .. "s"
            if sec == 15 and auto and not betPlaced then
                local side, conf = deepAnalysis()
                if conf >= confThres then
                    lastPred = side
                    betPlaced = true
                    ketqua.Text = string.format("🔮 DỰ ĐOÁN: %s\n📊 ĐỘ TIN CẬY: %d%%", side == "Ga" and "🐥 GÀ" or "🐻 GẤU", conf)
                    execBet(side, betCur)
                else
                    ketqua.Text = string.format("🔮 BỎ QUA (%.0f%% < %d%%)", conf, confThres)
                end
            end
        elseif act == "Result" then
            local winner = args[1]
            if not winner then return end
            local clean = (string.lower(winner) == "gau") and "Gau" or "Ga"

            if lastPred ~= "" and betPlaced then
                if lastPred == clean then
                    wins = wins + 1
                    loses = 0
                    betCur = betBase
                    addLog("[WIN] +1 | Tổng thắng: " .. wins, Color3.fromRGB(34, 197, 94))
                else
                    loses = loses + 1
                    if loses >= loseMax then
                        frozen = true
                        betCur = betBase
                        addLog("[LOSE] Thua " .. loses .. " lần! Khóa phiên", Color3.fromRGB(220, 38, 38))
                    else
                        betCur = betCur * 2
                        addLog("[LOSE] Tăng cược lên " .. betCur / 1e6 .. "M", Color3.fromRGB(245, 158, 11))
                    end
                end
                winText.Text = string.format("🏆 Thắng: %d/%d | Thua lt: %d", wins, winTarget, loses)
                betText.Text = "💰 Cược: " .. betCur / 1e6 .. "M"
            end

            table.insert(history, clean)
            if #history > 30 then table.remove(history, 1) end
            updateUI()
            addResult(clean)

            tGa, tGau = 0, 0
            lastPred = ""
            betPlaced = false
            ketqua.Text = "🔮 SẴN SÀNG PHIÊN TIẾP"

            if wins >= winTarget then
                autoBtn.Text = "🏆 HOÀN THÀNH"
                autoBtn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
                auto = false
            end
        elseif act == "SyncState" then
            local data = args[1] or {}
            if data.history then
                for _, v in ipairs(data.history) do
                    table.insert(history, (string.lower(tostring(v)) == "gau") and "Gau" or "Ga")
                end
                while #history > 30 do table.remove(history, 1) end
                updateUI()
                addLog("[SYNC] Đồng bộ " .. #history .. " kết quả", Color3.fromRGB(96, 165, 250))
            end
        end
    end)

    upd:FireServer("RequestSync")
    addLog("[ENGINE] Đã kết nối remote", Color3.fromRGB(34, 197, 94))
end)

