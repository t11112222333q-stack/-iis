    neuralWeights = nil,
    lastUpdated = os.time()
}

local DATA_FOLDER = "DeepMatrix_History/"
local MASTER_FILE = DATA_FOLDER .. "all_results.json"
local NEURAL_FILE = DATA_FOLDER .. "neural_weights.json"

local function loadDatabase()
    if not hasFileSupport then 
        AddLog("[DB] Không hỗ trợ ghi file, dữ liệu sẽ mất khi thoát", Color3.fromRGB(234, 179, 8))
        return 
    end
    local success, data = pcall(function()
        if ReadFile and isfile(MASTER_FILE) then
            local raw = ReadFile(MASTER_FILE)
            if raw and raw ~= "" then
                return HttpService:JSONDecode(raw)
            end
        end
        return nil
    end)
    if success and data and type(data) == "table" then
        GlobalDatabase.allResults = data.allResults or {}
        GlobalDatabase.patterns = data.patterns or {}
        GlobalDatabase.lastUpdated = data.lastUpdated or os.time()
        AddLog("[DB] Đã tải " .. tostring(#GlobalDatabase.allResults) .. " kết quả lịch sử", Color3.fromRGB(96, 165, 250))
    else
        GlobalDatabase.allResults = {}
        GlobalDatabase.patterns = {}
        AddLog("[DB] Không tìm thấy dữ liệu cũ, bắt đầu bộ nhớ mới", Color3.fromRGB(156, 163, 175))
    end
end

local function saveDatabase()
    if not hasFileSupport then return end
    GlobalDatabase.lastUpdated = os.time()
    local encoded = HttpService:JSONEncode(GlobalDatabase)
    WriteFile(MASTER_FILE, encoded)
end

local function addResultToDatabase(newResult)
    if not newResult then return end
    table.insert(GlobalDatabase.allResults, newResult)
    if #GlobalDatabase.allResults > 5000 then 
        table.remove(GlobalDatabase.allResults, 1) 
    end
    local len = #GlobalDatabase.allResults
    if len >= 3 then
        local pattern = GlobalDatabase.allResults[len-2] .. "_" .. GlobalDatabase.allResults[len-1] .. "_" .. GlobalDatabase.allResults[len]
        GlobalDatabase.patterns[pattern] = (GlobalDatabase.patterns[pattern] or 0) + 1
    end
    task.defer(function() saveDatabase() end)
end

local function findBestMatchByPattern(inputSequence)
    if #inputSequence < 2 then return nil, 0 end
    local totalOccurrences = 0
    local gaAfter = 0
    local gauAfter = 0
    for i = 1, #GlobalDatabase.allResults - #inputSequence do
        local match = true
        for j = 1, #inputSequence do
            if GlobalDatabase.allResults[i + j - 1] ~= inputSequence[j] then
                match = false
                break
            end
        end
        if match then
            totalOccurrences = totalOccurrences + 1
            local nextResult = GlobalDatabase.allResults[i + #inputSequence]
            if nextResult == "Ga" then 
                gaAfter = gaAfter + 1
            elseif nextResult == "Gau" then 
                gauAfter = gauAfter + 1
            end
        end
    end
    if totalOccurrences >= CONFIG.BACKTEST_PATTERN_MIN then
        local gaProb = (gaAfter / totalOccurrences) * 100
        local gauProb = (gauAfter / totalOccurrences) * 100
        if gaProb > gauProb then 
            return "Ga", math.floor(gaProb)
        else 
            return "Gau", math.floor(gauProb)
        end
    end
    return nil, 0
end
