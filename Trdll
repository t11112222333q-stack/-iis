-- HÀM DỰ ĐOÁN CHÍNH
local function deepAnalysis()
    for i = 1, 6 do anaTxt[i].Text = anaTitle[i] .. ": --" end
    if #history < 2 then return "Ga", 50 end

    local sGa, sGau = 0, 0

    -- H1: Trend Bias
    local cGa, cGau = 0, 0
    for i = math.max(1, #history - 13), #history do
        if history[i] == "Ga" then cGa = cGa + 1 else cGau = cGau + 1 end
    end
    if cGa > cGau then
        sGa = sGa + 1.5
        anaTxt[1].Text = anaTitle[1] .. ": GÀ (" .. cGa .. "/" .. (cGa + cGau) .. ")"
    elseif cGau > cGa then
        sGau = sGau + 1.5
        anaTxt[1].Text = anaTitle[1] .. ": GẤU (" .. cGau .. "/" .. (cGa + cGau) .. ")"
    else
        anaTxt[1].Text = anaTitle[1] .. ": Cân bằng"
    end

    -- H2: Dòng vốn
    if tGa > 0 and tGau > 0 then
        local total = tGa + tGau
        local pGa = (tGa / total) * 100
        anaTxt[2].Text = string.format(anaTitle[2] .. ": Gà %.0f%% | Gấu %.0f%%", pGa, 100 - pGa)
        if pGa >= 68 then
            sGa = sGa + 2.0
        elseif pGa <= 32 then
            sGau = sGau + 2.0
        end
    end

    -- H3: Pattern đối xứng
    if #history >= 4 then
        local l1, l2, l3, l4 = history[#history], history[#history-1], history[#history-2], history[#history-3]
        if l1 == l3 and l2 == l4 and l1 ~= l2 then
            if l1 == "Ga" then sGau = sGau + 1.8 else sGa = sGa + 1.8 end
            anaTxt[3].Text = anaTitle[3] .. ": Đối xứng 1-1"
        else
            anaTxt[3].Text = anaTitle[3] .. ": Chuỗi tự do"
        end
    end

    -- H4: Chống bão
    local streak, cur = 1, history[#history]
    for i = #history - 1, 1, -1 do
        if history[i] == cur then streak = streak + 1 else break end
    end
    if streak >= 4 then
        if cur == "Ga" then sGau = sGau + 2.5 else sGa = sGa + 2.5 end
        anaTxt[4].Text = string.format(anaTitle[4] .. ": Bẻ bão %s (dài %d)", cur == "Ga" and "GÀ" or "GẤU", streak)
    else
        anaTxt[4].Text = anaTitle[4] .. ": An toàn"
    end

    -- H5: Neural Net
    if #history >= 5 then
        local inp = {}
        for i = #history - 4, #history do inp[#inp + 1] = (history[i] == "Ga") and 1 or 0 end
        local out = neuralPredict(inp)
        if out[1] > out[2] + 0.15 then
            sGa = sGa + 2.2
            anaTxt[5].Text = string.format(anaTitle[5] .. ": GÀ (%.0f%%)", out[1] * 100)
        elseif out[2] > out[1] + 0.15 then
            sGau = sGau + 2.2
            anaTxt[5].Text = string.format(anaTitle[5] .. ": GẤU (%.0f%%)", out[2] * 100)
        else
            anaTxt[5].Text = anaTitle[5] .. ": Chờ thêm"
        end
    end

    -- H6: Global DB
    if #history >= 3 then
        local lastFew = {}
        for i = math.max(1, #history - 3), #history do lastFew[#lastFew + 1] = history[i] end
        local m, c = matchPattern(lastFew)
        if m then
            if m == "Ga" then
                sGa = sGa + 2.8 * (c / 100)
                anaTxt[6].Text = string.format(anaTitle[6] .. ": GÀ (%.0f%%)", c)
            else
                sGau = sGau + 2.8 * (c / 100)
                anaTxt[6].Text = string.format(anaTitle[6] .. ": GẤU (%.0f%%)", c)
            end
        else
            anaTxt[6].Text = anaTitle[6] .. ": Đủ 3 lần"
        end
    end

    local total = sGa + sGau
    if total == 0 then return "Ga", 50 end

    local pGa = (sGa / total) * 100
    barGa.Size = UDim2.new(pGa / 100, 0, 1, 0)
    barGau.Size = UDim2.new((100 - pGa) / 100, 0, 1, 0)
    barGau.Position = UDim2.new(pGa / 100, 0, 0, 0)
    barLabel.Text = string.format("🐥 GÀ %.0f%% | 🐻 GẤU %.0f%%", pGa, 100 - pGa)

    if sGa > sGau then
        return "Ga", 50 + math.floor((sGa / total) * 45)
    else
        return "Gau", 50 + math.floor((sGau / total) * 45)
    end
end

