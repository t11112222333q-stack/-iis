local function executeDeepAnalysis()
    local size = #historyMemory
    if size < 2 then 
        return "Ga", 50
    end

    local scoreGa = 0
    local scoreGau = 0

    -- HƯỚNG 1: Trend Bias (trọng số 1.5)
    local cGa, cGau = 0, 0
    for i = math.max(1, size - 13), size do
        if historyMemory[i] == "Ga" then cGa = cGa + 1 else cGau = cGau + 1 end
    end
    if cGa > cGau then 
        scoreGa = scoreGa + 1.5
        anaTexts[1].Text = anaTitles[1] .. ": Thiên về GÀ (" .. cGa .. "/" .. (cGa+cGau) .. ")"
    elseif cGau > cGa then 
        scoreGau = scoreGau + 1.5
        anaTexts[1].Text = anaTitles[1] .. ": Thiên về GẤU (" .. cGau .. "/" .. (cGa+cGau) .. ")"
    else
        anaTexts[1].Text = anaTitles[1] .. ": Cân bằng (50/50)"
    end

    -- HƯỚNG 2: Dòng vốn (trọng số 2.0)
    if tongTienGa > 0 and tongTienGau > 0 then
        local total = tongTienGa + tongTienGau
        local pGa = (tongTienGa / total) * 100
        local pGau = (tongTienGau / total) * 100
        anaTexts[2].Text = string.format(anaTitles[2] .. ": Gà %.1f%% | Gấu %.1f%%", pGa, pGau)
        if pGa >= 68 then scoreGa = scoreGa + 2.0
        elseif pGau >= 68 then scoreGau = scoreGau + 2.0
        end
    else
        anaTexts[2].Text = anaTitles[2] .. ": Đang tải dòng vốn..."
    end

    -- HƯỚNG 3: Pattern đối xứng (trọng số 1.8)
    if size >= 4 then
        local l1, l2, l3, l4 = historyMemory[size], historyMemory[size-1], historyMemory[size-2], historyMemory[size-3]
        if l1 == l3 and l2 == l4 and l1 ~= l2 then 
            if l1 == "Ga" then scoreGau = scoreGau + 1.8 else scoreGa = scoreGa + 1.8 end
            anaTexts[3].Text = anaTitles[3] .. ": Phát hiện mẫu đối xứng 1-1"
        else
            anaTexts[3].Text = anaTitles[3] .. ": Chuỗi tự do"
        end
    end

    -- HƯỚNG 4: Chống bão (trọng số 2.5)
    local streakCount = 1
    local currentSide = historyMemory[size]
    for i = size - 1, 1, -1 do
        if historyMemory[i] == currentSide then streakCount = streakCount + 1 else break end
    end
    if streakCount >= 4 then 
        if currentSide == "Ga" then scoreGau = scoreGau + 2.5 else scoreGa = scoreGa + 2.5 end
        anaTexts[4].Text = string.format(anaTitles[4] .. ": Kích hoạt bẻ bão %s (dài %d)", currentSide == "Ga" and "GÀ" or "GẤU", streakCount)
    else
        anaTexts[4].Text = anaTitles[4] .. ": Biên độ an toàn"
    end

    -- HƯỚNG 5: Neural Net (trọng số 2.2)
    if CONFIG.USE_NEURAL_NET and #historyMemory >= 5 then
        local inputs = {}
        for i = size-4, size do
            table.insert(inputs, (historyMemory[i] == "Ga") and 1 or 0)
        end
        local outputs = neuralPredict(inputs)
        if outputs[1] > outputs[2] + 0.15 then
            scoreGa = scoreGa + 2.2
            anaTexts[5].Text = anaTitles[5] .. ": Nghiêng về GÀ (" .. math.floor(outputs[1]*100) .. "%)"
        elseif outputs[2] > outputs[1] + 0.15 then
            scoreGau = scoreGau + 2.2
            anaTexts[5].Text = anaTitles[5] .. ": Nghiêng về GẤU (" .. math.floor(outputs[2]*100) .. "%)"
        else
            anaTexts[5].Text = anaTitles[5] .. ": Chưa đủ tin cậy"
        end
    end

    -- HƯỚNG 6: Global Database (trọng số 2.8)
    if CONFIG.USE_GLOBAL_DB and #historyMemory >= 3 then
        local lastFew = {}
        for i = math.max(1, size - 3), size do
            table.insert(lastFew, historyMemory[i])
        end
        local matchedSide, matchConf = findBestMatchByPattern(lastFew)
        if matchedSide then
            if matchedSide == "Ga" then
                scoreGa = scoreGa + 2.8 * (matchConf / 100)
                anaTexts[6].Text = string.format(anaTitles[6] .. ": Pattern %s → %s (%.0f%%)", table.concat(lastFew, "-"), "GÀ", matchConf)
            else
                scoreGau = scoreGau + 2.8 * (matchConf / 100)
                anaTexts[6].Text = string.format(anaTitles[6] .. ": Pattern %s → %s (%.0f%%)", table.concat(lastFew, "-"), "GẤU", matchConf)
            end
        else
            anaTexts[6].Text = anaTitles[6] .. ": Chưa đủ dữ liệu pattern"
        end
    end

    -- TÍNH TOÁN CUỐI CÙNG
    local totalScore = scoreGa + scoreGau
    local finalChoice = "Ga"
    local confidence = 50
    local probGa = 50
    local probGau = 50

    if totalScore > 0 then
        probGa = (scoreGa / totalScore) * 100
        probGau = (scoreGau / totalScore) * 100
        if scoreGa > scoreGau then
            finalChoice = "Ga"
            confidence = 50 + math.floor((scoreGa / totalScore) * 45)
        elseif scoreGau > scoreGa then
            finalChoice = "Gau"
            confidence = 50 + math.floor((scoreGau / totalScore) * 45)
        end
    end

    confidence = math.clamp(confidence, 55, 95)
    
    -- CẬP NHẬT BIỂU ĐỒ
    barGa.Size = UDim2.new(probGa / 100, 0, 1, 0)
    barGau.Size = UDim2.new(probGau / 100, 0, 1, 0)
    barGau.Position = UDim2.new(probGa / 100, 0, 0, 0)
    barLabel.Text = string.format("🐥 GÀ %.0f%%  |  🐼 GẤU %.0f%%", probGa, probGau)
    
    return finalChoice, confidence
end

