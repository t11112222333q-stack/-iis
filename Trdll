local function execBet(side, amt)
    if not auto then return end
    
    -- Kiểm tra số dư
    local currentMoney = getCurrentMoney()
    if currentMoney < amt then
        addLog("[ERROR] Không đủ tiền! Cần: " .. amt/1e6 .. "M, Có: " .. currentMoney/1e6 .. "M", Color3.fromRGB(220, 38, 38))
        return
    end
    
    task.spawn(function()
        pcall(function()
            local gaGauGui = player.PlayerGui:FindFirstChild("GaGauGui")
            if gaGauGui then
                local frameGaGau = gaGauGui:FindFirstChild("FrameGaGau")
                if frameGaGau then
                    local xacNhan = frameGaGau:FindFirstChild("XacNhan")
                    
                    if side == "Ga" then
                        local chonGa = frameGaGau:FindFirstChild("ChonGa")
                        local dienSoTienGa = frameGaGau:FindFirstChild("DienSoTienGa")
                        if chonGa and dienSoTienGa and xacNhan then
                            chonGa:Activate()
                            dienSoTienGa.Text = tostring(amt)
                            dienSoTienGa:ReleaseFocus(true)
                            task.wait(0.1)
                            xacNhan:Activate()
                            addLog("[ORDER] Lệnh GÀ " .. amt/1e6 .. "M", Color3.fromRGB(34, 197, 94))
                        end
                    elseif side == "Gau" then
                        local chonGau = frameGaGau:FindFirstChild("ChonGau")
                        local dienSoTienGau = frameGaGau:FindFirstChild("DienSoTienGau")
                        if chonGau and dienSoTienGau and xacNhan then
                            chonGau:Activate()
                            dienSoTienGau.Text = tostring(amt)
                            dienSoTienGau:ReleaseFocus(true)
                            task.wait(0.1)
                            xacNhan:Activate()
                            addLog("[ORDER] Lệnh GẤU " .. amt/1e6 .. "M", Color3.fromRGB(168, 85, 247))
                        end
                    end
                end
            end
        end)
    end)
end

