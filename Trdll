-- PHẦN 4/12: Z-SCORE, ENTROPY, MARTINGALE MANAGER
-- ============================================================================

local cooldownActive = false
local cooldownEndTime = 0
local totalWins = 0
local totalLosesInRow = 0
local isFrozenRound = false
local betPlacedInThisRound = false
local lastBotPrediction = ""

local function calculateZScore(sequence)
    if #sequence < 3 then return 0 end
    local sum, sumSq = 0, 0
    for i = 1, #sequence do
        local val = (sequence[i] == "Ga") and 1 or 0
        sum = sum + val
        sumSq = sumSq + val * val
    end
    local mean = sum / #sequence
    local variance = (sumSq / #sequence) - (mean * mean)
    if variance < 0.001 then return 0 end
    local std = math.sqrt(variance)
    local lastVal = (sequence[#sequence] == "Ga") and 1 or 0
    return math.abs((lastVal - mean) / std)
end

local function calculateEntropy(sequence)
    if #sequence < 3 then return 0 end
    local countGa, countGau = 0, 0
    for i = 1, #sequence do
        if sequence[i] == "Ga" then 
            countGa = countGa + 1 
        else 
            countGau = countGau + 1 
        end
    end
    local pGa = countGa / #sequence
    local pGau = countGau / #sequence
    local entropy = 0
    if pGa > 0 then 
        entropy = entropy - pGa * math.log(pGa) / math.log(2) 
    end
    if pGau > 0 then 
        entropy = entropy - pGau * math.log(pGau) / math.log(2) 
    end
    return entropy
end

