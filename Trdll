local historyMemory = {}
local tongTienGa, tongTienGau = 0, 0
local isAutoEnabled = false
local betPlacedInThisRound = false
local lastBotPrediction = ""
local totalWins = 0
local totalLosesInRow = 0
local isFrozenRound = false

local function updateHistoryUI()
