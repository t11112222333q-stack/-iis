                        for _, click in ipairs(connections(ChonGa.MouseButton1Click)) do click:Fire() end
                    else
                        ChonGa:Activate()
                    end
                    DienSoTienGa.Text = tostring(amount)
                    DienSoTienGa:ReleaseFocus(true)
                    if connections then
                        for _, click in ipairs(connections(XacNhan.MouseButton1Click)) do click:Fire() end
                    else
                        XacNhan:Activate()
                    end
                    AddLog("[ORDER] Lệnh GÀ | " .. tostring(amount/1000000) .. "M VND", Color3.fromRGB(34, 197, 94))
                end
            elseif targetSide == "Gau" then
                local ChonGau = FrameGaGau:FindFirstChild("ChonGau")
                local DienSoTienGau = FrameGaGau:FindFirstChild("DienSoTienGau")
                if ChonGau and DienSoTienGau then
                    local connections = getconnections or get_signal_cons
                    if connections then
                        for _, click in ipairs(connections(ChonGau.MouseButton1Click)) do click:Fire() end
                    else
                        ChonGau:Activate()
                    end
                    DienSoTienGau.Text = tostring(amount)
                    DienSoTienGau:ReleaseFocus(true)
                    if connections then
                        for _, click in ipairs(connections(XacNhan.MouseButton1Click)) do click:Fire() end
                    else
                        XacNhan:Activate()
                    end
                    AddLog("[ORDER] Lệnh GẤU | " .. tostring(amount/1000000) .. "M VND", Color3.fromRGB(168, 85, 247))
                end
            end
        end)
    end)
end

-- KẾT NỐI REMOTE
task.spawn(function()
    local remoteFolder = ReplicatedStorage:FindFirstChild("Remote")
    if not remoteFolder then 
        AddLog("[ERROR] Không tìm thấy Remote folder", Color3.fromRGB(220, 38, 38))
        return 
    end
    local GaGauUpdate = remoteFolder:FindFirstChild("GaGauUpdate")
    if not GaGauUpdate then 
        AddLog("[ERROR] Không tìm thấy GaGauUpdate", Color3.fromRGB(220, 38, 38))
        return 
    end
    
    GaGauUpdate.OnClientEvent:Connect(function(actionType, ...)
        local args = {...}
        
        if actionType == "UpdateTotals" then
            tongTienGa = args[1] or 0
            tongTienGau = args[2] or 0
            
        elseif actionType == "Countdown" then
            local sec = args[1]
            timeLabel.Text = "⏱️ XUNG NHỊP: " .. tostring(sec) .. "s"
            
            if sec == 15 and isAutoEnabled and not betPlacedInThisRound and not systemLockOverlay.Visible then
                local side, conf = executeDeepAnalysis()
                if conf >= CONFIDENCE_THRESHOLD then
                    lastBotPrediction = side
                    ketqua.Text = string.format("🔮 DỰ ĐOÁN: %s\n📊 ĐỘ TIN CẬY: %d%%", (side == "Ga") and "🐥 GÀ" or "🐼 GẤU", conf)
                    entropyLabel.Text = string.format("📊 Entropy: %.3f | Z-Score: %.2f", calculateEntropy(historyMemory), calculateZScore(historyMemory))
                    ExecuteAutoBet(lastBotPrediction, TIEN_CUOC_HIEN_TAI)
                else
                    lastBotPrediction = ""
                    ketqua.Text = string.format("🔮 DỰ ĐOÁN: BỎ QUA\n📊 ĐỘ TIN CẬY: %d%% (dưới ngưỡng)", conf)
                    AddLog(string.format("[SKIP] Bỏ qua phiên do độ tin cậy %d%% < %d%%", conf, CONFIDENCE_THRESHOLD), Color3.fromRGB(156, 163, 175))
                end
                betPlacedInThisRound = true
            end
            
        elseif actionType == "Result" then
            local winner = args[1]
            if not winner then return end
            local cleanWinner = (string.lower(winner) == "gau") and "Gau" or "Ga"
            
            if isFrozenRound then
                isFrozenRound = false
                totalLosesInRow = 0
                resetBetToBase()
                AddLog("[RISK] Giải phóng đóng băng, reset cược", Color3.fromRGB(34, 197, 94))
            else
                if lastBotPrediction ~= "" and betPlacedInThisRound then
                    if lastBotPrediction == cleanWinner then
                        totalWins = totalWins + 1
                        totalLosesInRow = 0
                        resetBetToBase()
                        AddLog("[RESULT] WIN! Reset cược về gốc", Color3.fromRGB(34, 197, 94))
                    else
                        totalLosesInRow = totalLosesInRow + 1
                        if totalLosesInRow >= THUA_LIEN_TIEP_MAX then
                            isFrozenRound = true
                            resetBetToBase()
                            AddLog("[CRITICAL] Thua " .. THUA_LIEN_TIEP_MAX .. " lần liên tiếp! Khóa lệnh 1 phiên", Color3.fromRGB(220, 38, 38))
                        else
                            doubleBet()
                            AddLog(string.format("[MARTINGALE] Thua! Tăng cược lên %dM", TIEN_CUOC_HIEN_TAI/1000000), Color3.fromRGB(245, 158, 11))
                        end
                    end
                    updateUIComponents()
                end
            end
            
            -- CẬP NHẬT LỊCH SỬ
            table.insert(historyMemory, cleanWinner)
            if #historyMemory > 30 then table.remove(historyMemory, 1) end
            updateHistoryUI()
            addResultToDatabase(cleanWinner)
            
            -- HUẤN LUYỆN NEURAL NET
            if CONFIG.USE_NEURAL_NET and #historyMemory >= 5 then
                local inputs = {}
                for i = #historyMemory-4, #historyMemory-1 do
                    table.insert(inputs, (historyMemory[i] == "Ga") and 1 or 0)
                end
                local target = (cleanWinner == "Ga") and {1, 0} or {0, 1}
                neuralTrain(inputs, target)
                saveNeuralWeights()
            end
            
            tongTienGa, tongTienGau = 0, 0
            lastBotPrediction = ""
            betPlacedInThisRound = false
            ketqua.Text = "🔮 DỰ ĐOÁN: SẴN SÀNG PHIÊN TIẾP"
            
            if totalWins >= MAX_WIN_TARGET then
                systemLockOverlay.Visible = true
                AddLog("[VICTORY] Đạt mục tiêu " .. MAX_WIN_TARGET .. " lần thắng! Hệ thống dừng", Color3.fromRGB(34, 197, 94))
            end
            
        elseif actionType == "SyncState" then
            local data = args[1] or {}
            if data.history then
                for _, v in ipairs(data.history) do
                    table.insert(historyMemory, (string.lower(tostring(v)) == "gau") and "Gau" or "Ga")
                end
                if #historyMemory > 30 then
                    while #historyMemory > 30 do table.remove(historyMemory, 1) end
                end
                updateHistoryUI()
                AddLog("[SYNC] Đã đồng bộ " .. #historyMemory .. " kết quả từ server", Color3.fromRGB(96, 165, 250))
            end
        end
    end)
    
    GaGauUpdate:FireServer("RequestSync")
    AddLog("[ENGINE] Đã kết nối remote thành công", Color3.fromRGB(34, 197, 94))
end)

