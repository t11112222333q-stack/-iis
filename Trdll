-- PHẦN 3/12: MẠNG NƠ RON NHÂN TẠO (5 INPUT - 8 HIDDEN - 2 OUTPUT)
-- ============================================================================

local weightsIH = {}
local weightsHO = {}

local function sigmoid(x)
    return 1 / (1 + math.exp(-x))
end

local function sigmoidDerivative(x)
    return x * (1 - x)
end

local function initNeuralNet()
    for i = 1, 5 do
        weightsIH[i] = {}
        for j = 1, 8 do
            weightsIH[i][j] = (math.random() - 0.5) * 2
        end
    end
    for i = 1, 8 do
        weightsHO[i] = {}
        for j = 1, 2 do
            weightsHO[i][j] = (math.random() - 0.5) * 2
        end
    end
    AddLog("[NN] Mạng nơ ron 5-8-2 đã khởi tạo", Color3.fromRGB(96, 165, 250))
end

local function neuralPredict(inputs)
    local hidden = {}
    for j = 1, 8 do
        local sum = 0
        for i = 1, 5 do
            sum = sum + inputs[i] * weightsIH[i][j]
        end
        hidden[j] = sigmoid(sum)
    end
    local outputs = {0, 0}
    for j = 1, 2 do
        local sum = 0
        for i = 1, 8 do
            sum = sum + hidden[i] * weightsHO[i][j]
        end
        outputs[j] = sigmoid(sum)
    end
    return outputs
end

local function neuralTrain(inputs, target)
    -- Forward pass
    local hidden = {}
    for j = 1, 8 do
        local sum = 0
        for i = 1, 5 do
            sum = sum + inputs[i] * weightsIH[i][j]
        end
        hidden[j] = sigmoid(sum)
    end
    local outputs = {0, 0}
    for j = 1, 2 do
        local sum = 0
        for i = 1, 8 do
            sum = sum + hidden[i] * weightsHO[i][j]
        end
        outputs[j] = sigmoid(sum)
    end
    -- Backpropagation
    local outputErrors = {target[1] - outputs[1], target[2] - outputs[2]}
    local hiddenErrors = {}
    for i = 1, 8 do
        local err = 0
        for j = 1, 2 do
            err = err + outputErrors[j] * sigmoidDerivative(outputs[j]) * weightsHO[i][j]
        end
        hiddenErrors[i] = err * sigmoidDerivative(hidden[i])
    end
    -- Cập nhật trọng số Hidden -> Output
    for i = 1, 8 do
        for j = 1, 2 do
            weightsHO[i][j] = weightsHO[i][j] + CONFIG.NEURAL_LEARNING_RATE * outputErrors[j] * sigmoidDerivative(outputs[j]) * hidden[i]
        end
    end
    -- Cập nhật trọng số Input -> Hidden
    for i = 1, 5 do
        for j = 1, 8 do
            weightsIH[i][j] = weightsIH[i][j] + CONFIG.NEURAL_LEARNING_RATE * hiddenErrors[j] * inputs[i]
        end
    end
end

local function loadNeuralWeights()
    if not hasFileSupport then return end
    if isfile(NEURAL_FILE) then
        local neuralData = ReadFile(NEURAL_FILE)
        if neuralData and neuralData ~= "" then
            local loaded = HttpService:JSONDecode(neuralData)
            if loaded and loaded.weightsIH and loaded.weightsHO then
                weightsIH = loaded.weightsIH
                weightsHO = loaded.weightsHO
                AddLog("[NN] Đã tải trọng số từ bộ nhớ", Color3.fromRGB(96, 165, 250))
                return
            end
        end
    end
    initNeuralNet()
end

local function saveNeuralWeights()
    if not hasFileSupport then return end
    local neuralData = HttpService:JSONEncode({weightsIH = weightsIH, weightsHO = weightsHO})
    WriteFile(NEURAL_FILE, neuralData)
end
