local db = {all = {}, pat = {}}

local function addResult(r)
    if not r then return end
    table.insert(db.all, r)
    if #db.all > 2000 then table.remove(db.all, 1) end
    if #db.all >= 3 then
        local p = db.all[#db.all-2].."_"..db.all[#db.all-1].."_"..db.all[#db.all]
        db.pat[p] = (db.pat[p] or 0) + 1
    end
    if hasFile then
        pcall(function() WriteFile("DM_history.json", HS:JSONEncode(db)) end)
    end
end

local function matchPattern(seq)
    if #seq < 2 then return nil, 0 end
    local total, ga, gau = 0, 0, 0
    for i = 1, #db.all - #seq do
        local match = true
        for j = 1, #seq do
            if db.all[i+j-1] ~= seq[j] then match = false break end
        end
        if match then
            total = total + 1
            local n = db.all[i + #seq]
            if n == "Ga" then ga = ga + 1 elseif n == "Gau" then gau = gau + 1 end
        end
    end
    if total >= 3 then
        if ga > gau then return "Ga", math.floor(ga/total*100)
        else return "Gau", math.floor(gau/total*100) end
    end
    return nil, 0
end

-- MẠNG NƠ RON 5-8-2
local wIH, wHO = {}, {}
for i = 1, 5 do wIH[i] = {} for j = 1, 8 do wIH[i][j] = (math.random()-0.5)*2 end end
for i = 1, 8 do wHO[i] = {} for j = 1, 2 do wHO[i][j] = (math.random()-0.5)*2 end end

local function sig(x) return 1/(1+math.exp(-x)) end

local function neuralPredict(inp)
    local h = {}
    for j = 1, 8 do
        local s = 0 for i = 1, 5 do s = s + inp[i] * (wIH[i] and wIH[i][j] or 0) end
        h[j] = sig(s)
    end
    local o = {0, 0}
    for j = 1, 2 do
        local s = 0 for i = 1, 8 do s = s + h[i] * (wHO[i] and wHO[i][j] or 0) end
        o[j] = sig(s)
    end
    return o
end

