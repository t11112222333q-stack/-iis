                if conf >= CONFIDENCE_THRESHOLD then
                    lastBotPrediction = side
                    ketqua.Text = string.format("🔮 DỰ ĐOÁN: %s\n📊 ĐỘ TIN CẬY: %d%%", side == "Ga" and "🐥 GÀ" or "🐻 GẤU", conf)
                    ExecuteAutoBet(side, TIEN_CUOC_HIEN_TAI)
                    betPlacedInThisRound = true
                else
                    ketqua.Text = string.format("🔮 BỎ QUA (%.0f%% < %d%%)", conf, CONFIDENCE_THRESHOLD)
                end
            end
            
        elseif act == "Result" then
            local winner = args[1]
            if not winner then return end
            local clean = (string.lower(winner) == "gau") and "Gau" or "Ga"
            
            if lastBotPrediction ~= "" and betPlacedInThisRound then
                if lastBotPrediction == clean then
                    totalWins = totalWins + 1
                    totalLosesInRow = 0
                    TIEN_CUOC_HIEN_TAI = TIEN_CUOC_GOC
                    AddLog("[WIN] +1 | Tổng thắng: " .. totalWins, Color3.fromRGB(34, 197, 94))
                else
                    totalLosesInRow = totalLosesInRow + 1
                    if totalLosesInRow >= THUA_LIEN_TIEP_MAX then
                        isFrozenRound = true
                        TIEN_CUOC_HIEN_TAI = TIEN_CUOC_GOC
                        AddLog("[LOSE] Thua " .. totalLosesInRow .. " lần liên tiếp! Khóa phiên", Color3.fromRGB(220, 38, 38))
                    else
                        TIEN_CUOC_HIEN_TAI = TIEN_CUOC_HIEN_TAI * 2
                        AddLog("[LOSE] Tăng cược lên " .. TIEN_CUOC_HIEN_TAI/1000000 .. "M", Color3.fromRGB(245, 158, 11))
                    end
                end
                winCountLabel.Text = string.format("🏆 Thắng: %d/150 | Thua lt: %d", totalWins, totalLosesInRow)
                betInfo.Text = "💰 Cược: " .. TIEN_CUOC_HIEN_TAI/1000000 .. "M"
            end
            
            table.insert(historyMemory, clean)
            if #historyMemory > 30 then table.remove(historyMemory, 1) end
            updateHistoryUI()
            addResultToDatabase(clean)
            
            tongTienGa, tongTienGau = 0, 0
            lastBotPrediction = ""
            betPlacedInThisRound = false
            ketqua.Text = "🔮 SẴN SÀNG PHIÊN TIẾP"
            
            if totalWins >= MAX_WIN_TARGET then
                autoBtn.Text = "🏆 HOÀN THÀNH MỤC TIÊU"
                autoBtn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
                isAutoEnabled = false
            end
            
        elseif act == "SyncState" then
            local data = args[1] or {}
            if data.history then
                for _, v in ipairs(data.history) do
                    table.insert(historyMemory, (string.lower(tostring(v)) == "gau") and "Gau" or "Ga")
                end
                while #historyMemory > 30 do table.remove(historyMemory, 1) end
                updateHistoryUI()
                AddLog("[SYNC] Đã đồng bộ " .. #historyMemory .. " kết quả", Color3.fromRGB(96, 165, 250))
            end
        end
    end)
    
    update:FireServer("RequestSync")
    AddLog("[ENGINE] Đã kết nối remote", Color3.fromRGB(34, 197, 94))
end)

